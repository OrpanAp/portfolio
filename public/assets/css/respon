/* ========================================================================== 
   Responsive pass: mobile-first refinements
   ========================================================================== */

@media (max-width: 1280px) {
  .featured-card {
    min-height: 480px;
  }
  .featured-card-image {
    height: 220px;
  }
  .portfolio-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 1024px) {
  .portfolio-filters {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .portfolio-filter-group:first-child {
    grid-column: 1 / -1;
  }
  .portfolio-filter-actions {
    grid-column: 1 / -1;
    justify-content: flex-start;
  }
  .portfolio-detail-info {
    grid-template-columns: 1fr;
  }
  .portfolio-live-preview-frame {
    min-height: 600px;
  }
}

@media (max-width: 820px) {
  :root {
    --nav-height: 68px;
  }

  .navbar-menu-toggle {
    position: relative;
    z-index: var(--z-drawer);
    width: 44px;
    height: 44px;
    display: grid;
    place-content: center;
    gap: 4px;
    padding: 0;
    border-radius: 12px;
  }
  .navbar-menu-toggle span {
    width: 19px;
    height: 2px;
    display: block;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform var(--duration-fast),
      opacity var(--duration-fast);
  }
  .site-header.menu-open .navbar-menu-toggle span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .site-header.menu-open .navbar-menu-toggle span:nth-child(2) {
    opacity: 0;
  }
  .site-header.menu-open .navbar-menu-toggle span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .navbar-links {
    position: fixed;
    top: 0;
    right: 0;
    z-index: calc(var(--z-drawer) - 1);

    width: min(360px, 88vw);
    max-width: 100vw;
    height: 100dvh;

    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: 0.35rem;

    padding: 6rem 2rem 2rem;

    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);

    transform: translate3d(105%, 0, 0);
    transition: transform 0.5s var(--ease-standard);

    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    box-sizing: border-box;
  }
  .site-header.menu-open .navbar-links {
    transform: translate3d(0, 0, 0);
  }
  .navbar-links > a {
    padding: 0.9rem 1rem;
    font-size: 1.05rem;
    border-radius: 0.8rem;
  }
  .navbar-links > a:hover {
    background: var(--color-surface-soft);
  }
  .navbar-links > a::after {
    display: none;
  }
  .theme-toggle {
    justify-content: center;
    margin: 0.75rem 0 0;
  }
  .navbar-backdrop {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;

    width: 100%;
    height: 100dvh;

    z-index: calc(var(--z-drawer) - 2);

    display: block;

    background: color-mix(in srgb, var(--color-bg) 65%, transparent);

    opacity: 0;
    visibility: hidden;

    backdrop-filter: blur(3px);

    transition:
      opacity var(--duration),
      visibility var(--duration);

    overflow: hidden;
  }
  .site-header.menu-open .navbar-backdrop {
    opacity: 1;
    visibility: visible;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }
  .featured-carousel {
    grid-template-columns: 42px minmax(0, 1fr) 42px;
    gap: 0.55rem;
  }
  .featured-carousel-track {
    grid-auto-columns: calc((100% - 1rem) / 2);
  }
  .featured-card {
    min-height: 455px;
  }
  .featured-card-image {
    height: 200px;
  }
  .profile-header {
    grid-template-columns: 150px 1fr;
  }
  .profile-image-wrapper {
    width: 140px;
  }
  .footer-container {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 600px) {
  main {
    width: min(var(--container), calc(100% - 2rem));
    padding: 2.8rem 0 4rem;
  }
  .navbar-logo-text {
    display: none;
  }
  .welcome-page {
    min-height: calc(100dvh - var(--nav-height));
    padding-inline: 1rem;
  }
  .welcome-title {
    font-size: clamp(3.2rem, 17vw, 5.8rem);
  }
  .welcome-kicker {
    font-size: 0.62rem;
  }
  .welcome-scroll-hint {
    margin-top: 3rem;
  }
  .home-hero {
    min-height: auto;
    padding: 4rem 0 5rem;
  }
  .home-hero h1 {
    font-size: clamp(2.8rem, 14vw, 5rem);
  }
  .home-actions {
    flex-direction: column;
    align-items: stretch;
  }
  .home-button {
    width: 100%;
  }
  .home-trust-row {
    flex-direction: column;
    gap: 0.45rem;
  }
  .featured-carousel {
    grid-template-columns: 38px minmax(0, 1fr) 38px;
  }
  .featured-carousel-track {
    grid-auto-columns: 100%;
  }
  .featured-card {
    min-height: 455px;
  }
  .featured-carousel-button {
    width: 38px;
    height: 38px;
  }

  .portfolio-header h1,
  .cv-header h1 {
    font-size: clamp(2.8rem, 14vw, 4.6rem);
  }
  .portfolio-filters {
    grid-template-columns: 1fr;
    padding: 0.8rem;
  }
  .portfolio-filter-group:first-child,
  .portfolio-filter-actions {
    grid-column: auto;
  }
  .portfolio-filter-actions {
    flex-direction: column;
  }
  .portfolio-filter-button,
  .portfolio-filter-reset {
    width: 100%;
  }
  .portfolio-grid {
    grid-template-columns: 1fr;
  }
  .portfolio-card-media {
    height: 220px;
  }
  .portfolio-pagination {
    gap: 0.35rem;
  }
  .portfolio-pagination a {
    min-width: 40px;
    height: 40px;
  }

  .portfolio-detail-header h1 {
    font-size: clamp(2.8rem, 14vw, 4.8rem);
  }
  .portfolio-live-preview-header {
    align-items: flex-start;
    flex-direction: column;
  }
  .portfolio-preview-open {
    width: 100%;
    justify-content: center;
  }
  .portfolio-live-preview-frame {
    min-height: 520px;
  }
  .portfolio-detail-thumbnail {
    min-height: 220px;
    border-radius: var(--radius-lg);
  }
  .portfolio-detail-info > div {
    border-left: 0;
    padding-inline: 0;
  }

  .profile-header {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
  }
  .profile-header-content h1 {
    font-size: clamp(2.8rem, 14vw, 5rem);
  }
  .profile-section {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .section-number {
    margin: 0;
  }

  .cv-header {
    align-items: stretch;
    flex-direction: column;
  }
  .cv-actions {
    flex-direction: column;
  }
  .cv-download-button,
  .cv-open-button {
    width: 100%;
  }
  .cv-preview {
    min-height: 650px;
    border-radius: var(--radius-lg);
  }

  .footer-container {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-top: 3rem;
  }
  .footer-bottom {
    flex-direction: column;
  }
}

@media (max-width: 480px) {
  .navbar-container {
    width: min(var(--container), calc(100% - 1rem));
  }
  .navbar-menu-toggle {
    width: 44px;
    height: 44px;
  }
  .welcome-subtitle {
    font-size: 0.95rem;
  }
  .welcome-button {
    width: 100%;
  }
  .portfolio-card-content {
    padding: 1.1rem;
  }
  .portfolio-detail-info {
    margin-bottom: 2rem;
  }
  .portfolio-live-preview-frame {
    min-height: 450px;
  }
  .preview-chrome small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}

@media (min-width: 1536px) {
  :root {
    --container: 1380px;
  }
  .featured-card-image {
    height: 270px;
  }
  .portfolio-card-media {
    height: 260px;
  }
}

@media (max-width: 359px) {
  .welcome-title {
    font-size: 3.05rem;
  }
  .featured-carousel {
    grid-template-columns: 34px minmax(0, 1fr) 34px;
  }
  .featured-carousel-button {
    width: 34px;
    height: 34px;
  }
}
