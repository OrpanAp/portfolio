RewriteEngine On

# Protect application files and directories
RewriteRule ^(?:app|config|database)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env|\.env\..*)$ - [F,L,NC]
RewriteRule ^(?:composer\.(?:json|lock)|README\.md)$ - [F,L,NC]

# Keep the public directory accessible
RewriteRule ^public(?:/|$) - [L]

# Redirect everything else to the public directory
RewriteRule ^(.*)$ public/$1 [L]
